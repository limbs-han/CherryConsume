{
  "datasets": [
    {
      "name": "cost_total",
      "displayName": "쓴 금액 합계",
      "queryLines": [
        "-- 합산 기간과 한도는 cherry_core.pipeline.cost.spend_window와 같다. 가입일이나 한도를 바꾸면 두 곳을 같이 고친다\n",
        "-- 가입일 2026-09-30부터 14일은 400달러, 그 뒤로는 달마다 30달러다. 날짜는 비용 차단처럼 UTC다\n",
        "WITH w AS (\n",
        "  SELECT\n",
        "    CASE WHEN current_date() < DATE'2026-10-14' THEN DATE'2026-09-30'\n",
        "         ELSE greatest(trunc(current_date(), 'MM'), DATE'2026-10-14') END AS start,\n",
        "    CASE WHEN current_date() < DATE'2026-10-14' THEN 400 ELSE 30 END AS limit_usd\n",
        "),\n",
        "spent AS (\n",
        "  SELECT coalesce(sum(u.usage_quantity * p.pricing.effective_list.default), 0) AS usd\n",
        "  FROM system.billing.usage u\n",
        "LEFT JOIN system.billing.list_prices p\n",
        "  ON u.sku_name = p.sku_name AND u.cloud = p.cloud AND u.usage_unit = p.usage_unit\n",
        " AND u.usage_end_time >= p.price_start_time\n",
        " AND (p.price_end_time IS NULL OR u.usage_end_time < p.price_end_time)\n",
        " AND p.currency_code = 'USD'\n",
        "  WHERE u.usage_date >= (SELECT start FROM w)\n",
        ")\n",
        "SELECT w.start, w.limit_usd, round(spent.usd, 2) AS spent_usd, round(w.limit_usd - spent.usd, 2) AS left_usd\n",
        "FROM w CROSS JOIN spent"
      ]
    },
    {
      "name": "cost_daily",
      "displayName": "날짜와 쓴 곳별 금액",
      "queryLines": [
        "SELECT u.usage_date AS day, u.billing_origin_product AS product,\n",
        "  round(sum(u.usage_quantity * p.pricing.effective_list.default), 2) AS usd\n",
        "FROM system.billing.usage u\n",
        "LEFT JOIN system.billing.list_prices p\n",
        "  ON u.sku_name = p.sku_name AND u.cloud = p.cloud AND u.usage_unit = p.usage_unit\n",
        " AND u.usage_end_time >= p.price_start_time\n",
        " AND (p.price_end_time IS NULL OR u.usage_end_time < p.price_end_time)\n",
        " AND p.currency_code = 'USD'\n",
        "WHERE u.usage_date >= current_date() - INTERVAL 60 DAYS\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "queue_total",
      "displayName": "열린 검수 대기 합계",
      "queryLines": [
        "SELECT count(*) AS open_items FROM queue WHERE status = 'open'"
      ]
    },
    {
      "name": "queue_kinds",
      "displayName": "종류별 열린 검수 대기",
      "queryLines": [
        "SELECT kind, count(*) AS open_items, min(created_at) AS oldest\n",
        "FROM queue WHERE status = 'open'\n",
        "GROUP BY kind ORDER BY kind"
      ]
    },
    {
      "name": "queue_list",
      "displayName": "열린 검수 대기 목록",
      "queryLines": [
        "SELECT created_at, kind, issuer, card_id, subject\n",
        "FROM queue WHERE status = 'open'\n",
        "ORDER BY created_at"
      ]
    },
    {
      "name": "collect_cards",
      "displayName": "카드별 마지막 수집",
      "queryLines": [
        "SELECT issuer, card_id, max(fetched_at) AS last_fetched,\n",
        "  datediff(current_date(), to_date(max(fetched_at))) AS days_ago\n",
        "FROM documents WHERE card_id IS NOT NULL\n",
        "GROUP BY ALL ORDER BY last_fetched"
      ]
    },
    {
      "name": "collect_daily",
      "displayName": "날짜와 카드사별 받은 원문",
      "queryLines": [
        "SELECT to_date(fetched_at) AS day, issuer, count(*) AS docs\n",
        "FROM documents\n",
        "WHERE fetched_at >= current_date() - INTERVAL 60 DAYS\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "changes_daily",
      "displayName": "날짜별 바뀐 원문",
      "queryLines": [
        "SELECT to_date(detected_at) AS day, issuer, card_id, source_id\n",
        "FROM changes WHERE card_id IS NOT NULL\n",
        "ORDER BY day DESC"
      ]
    },
    {
      "name": "history_events",
      "displayName": "최근 30일 바뀐 개정",
      "queryLines": [
        "-- 이력 표에서 개정이 열리고 닫힌 일. 작업 010 설계 3절\n",
        "-- 같은 판에서 같은 카드와 시행일이 닫히고 열리면 바뀐 개정이다. 이력 표의 첫 판은 첫 적재다\n",
        "WITH first AS (SELECT min(__START_AT.version) AS v FROM card_revision_history),\n",
        "opened AS (\n",
        "  SELECT card_id, effective_from, __START_AT.version AS v, __START_AT.at AS at, review_id\n",
        "  FROM card_revision_history\n",
        "),\n",
        "closed AS (\n",
        "  SELECT card_id, effective_from, __END_AT.version AS v, __END_AT.at AS at\n",
        "  FROM card_revision_history WHERE __END_AT IS NOT NULL\n",
        ")\n",
        "SELECT coalesce(o.at, c.at) AS at, to_date(coalesce(o.at, c.at)) AS day,\n",
        "  coalesce(o.card_id, c.card_id) AS card_id, coalesce(o.effective_from, c.effective_from) AS effective_from,\n",
        "  CASE WHEN o.v = (SELECT v FROM first) THEN '첫 적재'\n",
        "       WHEN o.card_id IS NOT NULL AND c.card_id IS NOT NULL THEN '바뀐 개정'\n",
        "       WHEN o.card_id IS NOT NULL THEN '새 개정'\n",
        "       ELSE '없어진 개정' END AS change,\n",
        "  o.review_id\n",
        "FROM opened o FULL OUTER JOIN closed c\n",
        "  ON o.card_id = c.card_id AND o.effective_from = c.effective_from AND o.v = c.v\n",
        "WHERE coalesce(o.at, c.at) >= current_date() - INTERVAL 30 DAYS\n",
        "ORDER BY at DESC\n"
      ]
    }
  ],
