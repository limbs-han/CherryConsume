{
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(uv run --project backend python -m cherry_core.catalog *)",
      "Bash(uv run --project backend pytest *)",
      "Bash(uvx ruff *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--script", "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--script", "${CLAUDE_PROJECT_DIR}/.claude/hooks/after_edit.py"],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--script", "${CLAUDE_PROJECT_DIR}/.claude/hooks/on_stop.py"],
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "humanize-korean@im-not-ai": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    },
    "ponytail": {
      "source": { "source": "git", "url": "https://github.com/DietrichGebert/ponytail.git" }
    },
    "im-not-ai": {
      "source": { "source": "git", "url": "https://github.com/epoko77-ai/im-not-ai.git" }
    }
  }
}
